import { Theme } from "theme.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------

export struct SftpEntry {
    name: string,
    full-path: string,
    is-dir: bool,
    size: string,
    modified: string,
}

export struct SftpTreeNode {
    path: string,
    name: string,
    depth: int,
    expanded: bool,
    has-children: bool,
}

// One row of the file-list right-click context menu.
component SftpMenuItem inherits Rectangle {
    in property <string> label;
    in property <brush> tint: Theme.text-primary;
    callback clicked();
    height: 26px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: 10px;
        text: root.label;
        color: root.tint;
        font-size: Theme.fs-sm;
        vertical-alignment: center;
        height: parent.height;
    }
}

// ---------------------------------------------------------------------------
// SftpPanel — left directory tree + right file listing
// ---------------------------------------------------------------------------

export component SftpPanel inherits Rectangle {
    // --- Properties --------------------------------------------------------
    in property <string>  current-path: "/";
    in property <[SftpEntry]>    entries;
    in property <string>  status: @tr("SFTP not connected");
    in property <bool>    loading: false;
    in property <[SftpTreeNode]> tree-nodes: [];

    // --- Callbacks ---------------------------------------------------------
    callback navigate(string);
    callback download(string);
    callback upload-clicked(string);            // 上传文件（弹本地文件选择框）
    callback upload-folder-clicked(string);     // 上传文件夹（弹本地目录选择框）
    callback refresh(string);
    callback tree-expand(string);   // toggle expand/collapse + navigate
    callback delete(string);        // remove a remote file/dir
    callback edit(string);          // 在应用内编辑器打开远端文件
    callback copy-path(string);     // 复制远端路径到剪贴板
    callback rename(string, string);      // (旧完整路径, 新名字)
    callback create-file(string, string); // (目录, 文件名)
    callback create-dir(string, string);  // (目录, 文件夹名)
    callback collapse-clicked();

    // -----------------------------------------------------------------------
    property <string> path-draft: current-path;
    changed current-path => { root.path-draft = root.current-path; root.selected-index = -1; }

    // 行内加载指示：双击 / 右键「打开」某个目录后记下目标路径，该行的文件夹
    // 图标前展开一个旋转动画。加载终结时 Rust 侧统一复位 `loading`（成功
    // SftpEntries / 失败 SftpLoadFailed 都会），这里跟着清掉目标即可。
    property <string> loading-target: "";
    changed loading => { if (!root.loading) { root.loading-target = ""; } }

    // 目录树宽度（分隔把手左右拖动调整）。
    in-out property <length> tree-width: 160px;

    // 选中行：右键或单击高亮，-1 表示无选中。右键弹菜单时 hover 会转移到
    // 菜单上、行 has-hover 变 false，靠这个状态保持蓝色高亮不丢。
    property <int> selected-index: -1;

    // --- 名称输入对话框（重命名 / 新建文件 / 新建文件夹共用） --------------
    property <bool> name-dialog-open: false;
    property <int> name-dialog-mode: 0;        // 0=重命名 1=新建文件 2=新建文件夹
    property <string> name-dialog-target: "";  // 重命名=旧完整路径；新建=所在目录
    property <string> name-draft: "";

    function open-name-dialog(mode: int, target: string, initial: string) {
        root.name-dialog-mode = mode;
        root.name-dialog-target = target;
        root.name-draft = initial;
        root.name-dialog-open = true;
    }
    function commit-name-dialog() {
        if (root.name-draft == "") {
            return;
        }
        if (root.name-dialog-mode == 0) {
            root.rename(root.name-dialog-target, root.name-draft);
        } else if (root.name-dialog-mode == 1) {
            root.create-file(root.name-dialog-target, root.name-draft);
        } else {
            root.create-dir(root.name-dialog-target, root.name-draft);
        }
        root.name-dialog-open = false;
    }

    background: Theme.bg-panel;

    VerticalLayout {
        spacing: 0;

        // --- Toolbar / path bar (full width) -------------------------------
        Rectangle {
            height: 44px;
            background: Theme.bg-main;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;

                Text {
                    text: "\u{e2c7}";   // Material Icons "folder"
                    font-family: "Material Icons";
                    color: Theme.folder;
                    font-size: 17px;
                    vertical-alignment: center;
                }

                // Editable path bar (borderless, monospace). Enter navigates.
                Rectangle {
                    background: transparent;
                    horizontal-stretch: 1;
                    path-input := TextInput {
                        width: parent.width;
                        height: parent.height;
                        text <=> root.path-draft;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        single-line: true;
                        key-pressed(e) => {
                            if (e.text == Key.Return || e.text == "\u{000D}") {
                                if (self.text != "") { root.navigate(self.text); }
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                    if root.path-draft == "" : Text {
                        text: @tr("Enter remote path");
                        color: Theme.text-faint;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }

                up-btn := Rectangle {
                    width: 30px; height: 30px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: up-ta.has-hover ? Theme.row-hover : transparent;
                    up-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.navigate(".."); }
                    }
                    Text { text: "\u{e316}"; font-family: "Material Icons";   // keyboard_arrow_up
                           color: up-ta.has-hover ? Theme.text : Theme.text-dim; font-size: 16px;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    height: 30px;
                    border-radius: 7px;
                    background: ul-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    HorizontalLayout {
                        padding-left: 13px; padding-right: 13px; spacing: 6px;
                        alignment: center;
                        Text { text: "\u{e2c6}"; font-family: "Material Icons"; color: #ffffff;   // file_upload
                               font-size: 15px; vertical-alignment: center; }
                        Text { text: @tr("Upload"); color: #ffffff; font-size: Theme.fs-sm; font-weight: 600;
                               vertical-alignment: center; }
                    }
                    ul-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.upload-clicked(root.current-path); }
                    }
                }

                Rectangle {
                    width: 30px; height: 30px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: ref-ta.has-hover ? Theme.row-hover : transparent;
                    ref-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.refresh(root.current-path); }
                    }
                    Text { text: "\u{E5D5}"; font-family: "Material Icons";
                           color: ref-ta.has-hover ? Theme.text : Theme.text-dim; font-size: 15px;
                           horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 30px; height: 30px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: collapse-ta.has-hover ? Theme.row-hover : transparent;
                    collapse-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.collapse-clicked(); }
                    }
                    Text {
                        text: "\u{E5CE}";
                        font-family: "Material Icons";
                        color: collapse-ta.has-hover ? Theme.text : Theme.text-dim;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // --- Main area: tree (left) + file list (right) --------------------
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0;

            // ── Left: directory tree ────────────────────────────────────────
            VerticalLayout {
                width: root.tree-width;
                spacing: 0;

                // Tree header
                Rectangle {
                    height: 30px;
                    background: Theme.col-head;
                    Text {
                        x: 14px;
                        text: @tr("Directory tree");
                        font-family: Theme.font-mono;
                        color: Theme.text-faint;
                        font-size: 10px;
                        font-weight: 500;
                        letter-spacing: 0.7px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // Tree list with scrollbar
                ScrollView {
                    vertical-stretch: 1;

                    tree-list := VerticalLayout {
                        spacing: 0;

                        for node[i] in root.tree-nodes : Rectangle {
                            height: 27px;
                            background: node-ta.has-hover
                                ? Theme.row-hover
                                : (node.path == root.current-path
                                    ? Theme.accent-soft
                                    : transparent);

                            node-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.tree-expand(node.path); }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                padding-left: 8px;
                                padding-right: 10px;

                                // Depth indent spacer
                                Rectangle { width: node.depth * 14px; }

                                // Expand/collapse arrow
                                Text {
                                    width: 12px;
                                    text: node.has-children
                                        ? (node.expanded ? "▾" : "▸")
                                        : " ";
                                    color: Theme.text-faint;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Folder glyph
                                Text {
                                    text: "\u{e2c7}";   // Material Icons "folder"
                                    font-family: "Material Icons";
                                    color: Theme.folder;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }

                                // Folder name
                                Text {
                                    text: node.depth == 0 ? "/" : node.name;
                                    font-family: Theme.font-mono;
                                    color: node.path == root.current-path
                                        ? Theme.accent
                                        : Theme.text-dim;
                                    font-weight: node.depth == 0 ? 600 : 400;
                                    font-size: 12px;
                                    horizontal-stretch: 1;
                                    overflow: clip;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Vertical separator — drag left/right to resize the tree.
            Rectangle {
                width: 4px;
                background: tree-divider-ta.has-hover || tree-divider-ta.pressed
                    ? Theme.accent
                    : Theme.border-subtle;

                tree-divider-ta := TouchArea {
                    mouse-cursor: col-resize;
                    property <length> press-x;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            self.press-x = self.mouse-x;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.tree-width = clamp(
                                root.tree-width + self.mouse-x - self.press-x,
                                100px,
                                max(120px, root.width - 240px));
                        }
                    }
                }
            }

            // ── Right: file listing ─────────────────────────────────────────
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0;

                // Column headers
                Rectangle {
                    height: 30px;
                    background: Theme.col-head;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 12px;
                        Text { text: @tr("Name"); font-family: Theme.font-mono; color: Theme.text-faint;
                               font-size: 10px; font-weight: 500; letter-spacing: 0.7px;
                               horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: @tr("Size"); font-family: Theme.font-mono; color: Theme.text-faint;
                               font-size: 10px; font-weight: 500; letter-spacing: 0.7px;
                               width: 72px; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: @tr("Modified"); font-family: Theme.font-mono; color: Theme.text-faint;
                               font-size: 10px; font-weight: 500; letter-spacing: 0.7px;
                               width: 116px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // File list with scrollbar
                ScrollView {
                    vertical-stretch: 1;

                    file-list := VerticalLayout {
                        spacing: 0;

                        // 顶部整体「Loading...」行：仅在没有具体目标行（终端 cd
                        // 联动、路径栏直接输入等）时显示；点击目录导航时由该行
                        // 图标前的 spinner 提示，避免双重加载指示。
                        if root.loading && root.loading-target == "" : Rectangle {
                            height: 40px;
                            Text { text: @tr("Loading..."); color: Theme.text-muted; font-size: Theme.fs-sm;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }

                        if !root.loading && root.entries.length == 0 : Rectangle {
                            height: 40px;
                            Text { text: @tr("Empty directory"); color: Theme.text-muted; font-size: Theme.fs-sm;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }

                        // 整体加载(终端 cd 联动 / 路径栏导航 / 刷新，loading-target 为空)时
                        // 用空 model 隐藏过期文件列表，避免被顶部「Loading...」行整体下推；
                        // 行内加载(loading-target 指向某目录)仍展示列表以呈现该行 spinner。
                        for entry[i] in ((root.loading && root.loading-target == "") ? [] : root.entries) : row := Rectangle {
                            height: 26px;
                            background: (row-ta.has-hover || root.selected-index == i)
                                ? Theme.accent-soft
                                : transparent;

                            // Right-click anchor (relative to this row).
                            property <length> mx;
                            property <length> my;

                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.selected-index = i; }
                                double-clicked => {
                                    if (entry.is-dir) {
                                        root.loading-target = entry.full-path;
                                        root.navigate(entry.full-path);
                                    } else {
                                        root.download(entry.full-path);
                                    }
                                }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down
                                            && ev.button == PointerEventButton.right) {
                                        root.selected-index = i;
                                        row.mx = self.mouse-x;
                                        row.my = self.mouse-y;
                                        row-menu.show();
                                    }
                                }
                            }

                            // Right-click context menu (same set for files & dirs;
                            // Open = enter dir / open file in the built-in editor).
                            row-menu := PopupWindow {
                                x: row.mx;
                                y: row.my;
                                width: 132px;
                                height: 6 * 27px + 8px;
                                Rectangle {
                                    background: Theme.bg-panel;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 12px;
                                    drop-shadow-color: #00000060;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        SftpMenuItem {
                                            label: @tr("Open");
                                            clicked => {
                                                if (entry.is-dir) {
                                                    root.loading-target = entry.full-path;
                                                    root.navigate(entry.full-path);
                                                } else {
                                                    root.edit(entry.full-path);
                                                }
                                            }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Download");
                                            clicked => { root.download(entry.full-path); }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Copy path");
                                            clicked => { root.copy-path(entry.full-path); }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Rename");
                                            clicked => {
                                                root.open-name-dialog(0, entry.full-path, entry.name);
                                            }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Delete");
                                            tint: #d86c6c;
                                            clicked => { root.delete(entry.full-path); }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Refresh");
                                            clicked => { root.refresh(root.current-path); }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; spacing: 8px;

                                // 图标组：加载中的目录在文件夹图标前平滑展开一个
                                // 旋转的加载指示（spacing:0 的子布局保证未加载时
                                // 图标位置与原来分毫不差，不影响列对齐）。
                                // horizontal-stretch 必须归零：嵌套 layout 默认
                                // stretch=1，会与名称列对半瓜分剩余宽度，把名称
                                // 推到行中间（看起来像"居中对齐"）。
                                HorizontalLayout {
                                    spacing: 0;
                                    horizontal-stretch: 0;
                                    spin-slot := Rectangle {
                                        property <bool> active: entry.is-dir
                                            && root.loading
                                            && root.loading-target == entry.full-path;
                                        width: self.active ? 18px : 0px;
                                        animate width { duration: 120ms; easing: ease-out; }
                                        clip: true;
                                        if spin-slot.active : Text {
                                            text: "\u{e863}";   // Material Icons "autorenew"
                                            font-family: "Material Icons";
                                            color: Theme.accent;
                                            font-size: Theme.fs-md;
                                            width: 16px;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            transform-rotation: (animation-tick() / 1.2s) * 360deg;
                                        }
                                    }
                                    Text {
                                        text: entry.is-dir ? "\u{e2c7}" : "\u{e873}";
                                        font-family: "Material Icons";
                                        color: entry.is-dir ? Theme.folder-icon : Theme.text-muted;
                                        font-size: Theme.fs-md;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: entry.name;
                                    font-family: Theme.font-mono;
                                    color: Theme.text;
                                    font-size: Theme.fs-sm;
                                    horizontal-stretch: 1;
                                    overflow: clip;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: entry.is-dir ? "" : entry.size;
                                    font-family: Theme.font-mono;
                                    color: Theme.text-faint; font-size: Theme.fs-xs;
                                    width: 72px; horizontal-alignment: right; vertical-alignment: center;
                                }
                                Text {
                                    text: entry.modified;
                                    font-family: Theme.font-mono;
                                    color: Theme.text-dim; font-size: Theme.fs-xs;
                                    width: 116px; horizontal-alignment: right; vertical-alignment: center;
                                }
                            }
                        }

                        // Blank tail zone: right-click for directory-level actions
                        // (refresh / upload / new file / new folder / copy path).
                        blank-zone := Rectangle {
                            vertical-stretch: 1;
                            min-height: 48px;
                            property <length> bx;
                            property <length> by;

                            blank-ta := TouchArea {
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down
                                            && ev.button == PointerEventButton.right) {
                                        root.selected-index = -1;
                                        blank-zone.bx = self.mouse-x;
                                        blank-zone.by = self.mouse-y;
                                        blank-menu.show();
                                    }
                                }
                            }

                            blank-menu := PopupWindow {
                                x: blank-zone.bx;
                                y: blank-zone.by;
                                width: 132px;
                                height: 6 * 27px + 8px;
                                Rectangle {
                                    background: Theme.bg-panel;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 12px;
                                    drop-shadow-color: #00000060;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        SftpMenuItem {
                                            label: @tr("Refresh");
                                            clicked => { root.refresh(root.current-path); }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Upload file");
                                            clicked => { root.upload-clicked(root.current-path); }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Upload folder");
                                            clicked => { root.upload-folder-clicked(root.current-path); }
                                        }
                                        SftpMenuItem {
                                            label: @tr("New file");
                                            clicked => {
                                                root.open-name-dialog(1, root.current-path, "");
                                            }
                                        }
                                        SftpMenuItem {
                                            label: @tr("New folder");
                                            clicked => {
                                                root.open-name-dialog(2, root.current-path, "");
                                            }
                                        }
                                        SftpMenuItem {
                                            label: @tr("Copy path");
                                            clicked => { root.copy-path(root.current-path); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Status bar (full width) --------------------------------------
        Rectangle {
            height: 18px;
            background: Theme.bg-panel-alt;
            Text {
                x: 8px;
                text: root.status;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                height: parent.height;
                overflow: clip;
                width: parent.width - 16px;
            }
        }
    }

    // --- Name input dialog (rename / new file / new folder) ----------------
    if root.name-dialog-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000060;

        // Swallow clicks behind the dialog; clicking the mask cancels.
        TouchArea {
            clicked => { root.name-dialog-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(8px, (parent.height - self.height) / 2);
            width: min(320px, parent.width - 24px);
            height: 108px;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000070;

            // Block the mask's cancel-click inside the dialog body.
            TouchArea {}

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: root.name-dialog-mode == 0 ? @tr("Rename")
                        : root.name-dialog-mode == 1 ? @tr("New file")
                        : @tr("New folder");
                    color: Theme.text-primary;
                    font-size: Theme.fs-md;
                    font-weight: 700;
                }

                name-edit := LineEdit {
                    text <=> root.name-draft;
                    placeholder-text: @tr("Enter name");
                    font-size: Theme.fs-sm;
                    accepted => { root.commit-name-dialog(); }
                    init => { self.focus(); }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    Rectangle {
                        width: 64px; height: 24px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        background: cancel-ta.has-hover ? Theme.bg-hover : transparent;
                        cancel-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.name-dialog-open = false; }
                        }
                        Text {
                            text: @tr("Cancel");
                            color: Theme.text-primary;
                            font-size: Theme.fs-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 64px; height: 24px;
                        border-radius: Theme.radius-sm;
                        background: ok-ta.has-hover ? Theme.accent-hover : Theme.accent;
                        ok-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.commit-name-dialog(); }
                        }
                        Text {
                            text: @tr("OK");
                            color: #ffffff;
                            font-size: Theme.fs-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
