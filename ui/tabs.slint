import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";

export struct TabInfo {
    id: string,
    title: string,
    kind: string,   // "welcome" | "terminal"
    connected: bool,
}

// --- SingleTab -------------------------------------------------------------
// Flat tab with an accent underline when active (no pill background).
component SingleTab inherits Rectangle {
    in property <TabInfo> info;
    in property <bool> active;
    callback selected();
    callback closed();

    min-width: 90px;
    max-width: 170px;
    horizontal-stretch: 0;
    background: !active && touch.has-hover ? Theme.row-hover : transparent;
    animate background { duration: 120ms; }

    // active underline, flush with the bar's bottom border
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: parent.width;
        background: root.active ? Theme.accent : transparent;
    }

    // Declared FIRST so the HorizontalLayout's children (close button) are at
    // a higher z-order and receive their own click events.
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        // Status indicator
        Rectangle {
            width: 7px; height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: info.kind == "welcome" ? Theme.text-faint
                : (info.connected ? Theme.ok : Theme.warn);
        }

        Text {
            text: info.title;
            color: active ? Theme.text : Theme.text-dim;
            font-size: 12.5px;
            font-weight: active ? 600 : 500;
            vertical-alignment: center;
            overflow: clip;
            horizontal-stretch: 1;
        }

        // Only show close button for non-welcome tabs
        if info.kind != "welcome" : IconButton {
            glyph: "×";
            size: 18px;
            y: (parent.height - self.height) / 2;
            fg: Theme.text-faint;
            clicked => { root.closed(); }
        }
    }
}

// --- TabBar ----------------------------------------------------------------
export component TabBar inherits Rectangle {
    in property <[TabInfo]> tabs;
    in property <string> active-id;
    callback tab-selected(string);
    callback tab-closed(string);
    callback new-tab();

    height: 42px;
    background: Theme.bg-main;

    // bottom hairline
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;

        for tab[i] in tabs : SingleTab {
            info: tab;
            active: tab.id == root.active-id;
            selected => { root.tab-selected(tab.id); }
            closed => { root.tab-closed(tab.id); }
        }

        IconButton {
            glyph: "+";
            size: 28px;
            y: (parent.height - self.height) / 2;
            clicked => { root.new-tab(); }
        }

        // Spacer
        Rectangle { horizontal-stretch: 1; }
    }
}
