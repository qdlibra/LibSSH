import { Theme } from "theme.slint";
import { Sparkline } from "widgets.slint";

// One filesystem row for the mount-usage panel.
export struct DiskInfo {
    path: string,
    detail: string,   // "available/total"
    percent: float,   // used fraction 0.0..1.0
}

// --- SideHeading -----------------------------------------------------------
// Small faint section label (运行状态 / 服务器资源 / 挂载点 …).
component SideHeading inherits Text {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.7px;
    color: Theme.text-faint;
    vertical-alignment: center;
}

// --- Meter -----------------------------------------------------------------
// CPU / memory / swap: [label .... value] over a thin track, optional detail.
component Meter inherits VerticalLayout {
    in property <string> label;
    in property <float> percent;   // 0.0 .. 1.0
    in property <string> detail;
    spacing: 5px;

    HorizontalLayout {
        Text {
            text: label;
            font-family: Theme.font-mono;
            font-size: 11px;
            font-weight: 500;
            color: Theme.text-dim;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: Math.round(clamp(percent, 0.0, 1.0) * 100) + "%";
            font-family: Theme.font-mono;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 5px;
        border-radius: 2.5px;
        background: Theme.track;
        clip: true;
        Rectangle {
            x: 0;
            y: 0;
            height: parent.height;
            width: parent.width * clamp(percent, 0.0, 1.0);
            border-radius: 2.5px;
            background: percent < 0.6 ? Theme.ok : percent < 0.85 ? Theme.warn : Theme.danger;
            animate width { duration: 500ms; easing: ease-out; }
        }
    }

    if detail != "" : Text {
        text: detail;
        font-family: Theme.font-mono;
        font-size: 10px;
        color: Theme.text-faint;
    }
}

// --- MountRow --------------------------------------------------------------
component MountRow inherits Rectangle {
    in property <string> path;
    in property <string> detail;
    in property <float> percent;

    height: row.preferred-height + 14px;
    border-radius: 7px;
    background: ta.has-hover ? Theme.row-hover : transparent;
    ta := TouchArea {}

    row := VerticalLayout {
        x: 8px;
        y: 7px;
        width: parent.width - 16px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: path;
                font-family: Theme.font-mono;
                font-size: 11px;
                font-weight: 500;
                color: Theme.text-dim;
                horizontal-stretch: 1;
                overflow: clip;
                vertical-alignment: center;
            }
            Text {
                text: detail;
                font-family: Theme.font-mono;
                font-size: 10px;
                color: Theme.text-faint;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.track;
            clip: true;
            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * clamp(percent, 0.0, 1.0);
                border-radius: 2px;
                background: percent < 0.6 ? Theme.ok : percent < 0.85 ? Theme.warn : Theme.danger;
            }
        }
    }
}

// --- NetSection ------------------------------------------------------------
// Throughput header (↑ tx / ↓ rx, optional NIC selector) over a bar sparkline.
component NetSection inherits VerticalLayout {
    in property <string> heading;
    in property <string> up-text;
    in property <string> down-text;
    in property <[float]> history;
    in property <brush> bar-color: Theme.accent;
    in property <float> bar-opacity: 0.45;
    in property <bool> show-selector: false;
    in property <[string]> ifaces;
    in property <string> selected;
    callback iface-selected(string);

    vertical-stretch: 0;
    spacing: 8px;

    HorizontalLayout {
        SideHeading {
            text: root.heading;
            horizontal-stretch: 1;
        }
        if root.show-selector : Rectangle {
            width: 60px;
            height: 18px;
            border-radius: 6px;
            background: Theme.card;
            border-width: 1px;
            border-color: sel-ta.has-hover ? Theme.border-strong : Theme.border;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                spacing: 2px;
                Text {
                    text: root.selected;
                    font-family: Theme.font-mono;
                    font-size: 10px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: clip;
                }
                Text {
                    text: "\u{E5CF}";   // expand_more
                    font-family: "Material Icons";
                    color: Theme.text-faint;
                    font-size: 9px;
                    vertical-alignment: center;
                }
            }

            sel-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { popup.show(); }
            }

            popup := PopupWindow {
                x: 0;
                y: parent.height + 3px;
                width: 96px;
                Rectangle {
                    background: Theme.card;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Theme.shadow-color;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 1px;
                        for iface in root.ifaces : Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: row-ta.has-hover ? Theme.row-hover : transparent;
                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.iface-selected(iface); }
                            }
                            Text {
                                x: 7px;
                                text: iface;
                                font-family: Theme.font-mono;
                                color: Theme.text;
                                font-size: 11px;
                                vertical-alignment: center;
                                height: parent.height;
                            }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        HorizontalLayout {
            spacing: 4px;
            Text { text: "↑"; font-family: Theme.font-mono; font-size: 11px; color: Theme.text-faint; vertical-alignment: center; }
            Text { text: root.up-text; font-family: Theme.font-mono; font-size: 11px; font-weight: 500; color: Theme.text; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 4px;
            Text { text: "↓"; font-family: Theme.font-mono; font-size: 11px; color: Theme.text-faint; vertical-alignment: center; }
            Text { text: root.down-text; font-family: Theme.font-mono; font-size: 11px; font-weight: 500; color: Theme.text; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    Sparkline {
        height: 34px;
        values: root.history;
        line-color: root.bar-color;
        bar-opacity: root.bar-opacity;
    }
}

// --- SegThemeButton --------------------------------------------------------
component SegThemeButton inherits Rectangle {
    in property <string> icon;
    in property <int> value;

    width: 28px;
    height: 24px;
    border-radius: 6px;
    background: Theme.mode == value ? Theme.seg-active : (seg-ta.has-hover ? Theme.row-hover : transparent);
    animate background { duration: 120ms; }

    Text {
        text: icon;
        font-family: "Material Icons";
        font-size: 14px;
        color: Theme.mode == value ? Theme.text : Theme.text-faint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    seg-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Theme.mode = value; }
    }
}

// --- Sidebar ---------------------------------------------------------------
export component Sidebar inherits Rectangle {
    in property <string> app-version;                // 由 app.slint 透传 CARGO_PKG_VERSION，勿写死
    in property <string> connection-state: @tr("Not connected");
    in property <int> conn-state;                    // 0 gray / 1 green / 2 yellow
    in property <string> resource-title: @tr("Local resources");
    in property <float> cpu-percent;
    in property <float> mem-percent;
    in property <float> swap-percent;
    in property <string> mem-detail;
    in property <string> swap-detail;
    in property <string> net-top-up;
    in property <string> net-top-down;
    in property <[float]> net-top-history;
    in property <string> net-bot-up;
    in property <string> net-bot-down;
    in property <[float]> net-bot-history;
    in property <[string]> net-ifaces;
    in property <string> net-selected;
    in property <bool> net-show-selector;
    in property <[DiskInfo]> disks;
    in-out property <bool> collapsed: false;
    callback select-net-iface(string);

    width: root.collapsed ? 30px : 266px;
    background: Theme.bg-sidebar;
    border-width: 0;

    // right hairline border
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    if root.collapsed : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.bg-sidebar;

        Rectangle {
            x: 4px;
            y: 12px;
            width: 22px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: show-ta.has-hover ? Theme.row-hover : transparent;
            show-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.collapsed = false; }
            }
            Text {
                text: "\u{E5CC}";   // chevron_right
                font-family: "Material Icons";
                color: Theme.text-dim;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if !root.collapsed : VerticalLayout {
        // --- scroll region ---
        Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: max(self.height, content.preferred-height);

            content := VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 20px;
                alignment: start;

                // status
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        SideHeading {
                            text: @tr("Status");
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: Theme.radius-sm;
                            background: hide-ta.has-hover ? Theme.row-hover : transparent;
                            hide-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.collapsed = true; }
                            }
                            Text {
                                text: "\u{E5CB}";   // chevron_left
                                font-family: "Material Icons";
                                color: Theme.text-faint;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle {
                        height: status-col.preferred-height + 22px;
                        background: Theme.card;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Theme.border;
                        drop-shadow-blur: 2px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: Theme.shadow-color;

                        status-col := VerticalLayout {
                            x: 12px;
                            y: 11px;
                            width: parent.width - 24px;
                            spacing: 5px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: root.conn-state == 1 ? Theme.ok
                                              : root.conn-state == 2 ? Theme.warn
                                              : Theme.text-faint;
                                }
                                Text {
                                    text: root.connection-state;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: clip;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }

                // server / local resources
                VerticalLayout {
                    spacing: 12px;
                    SideHeading { text: root.resource-title; }
                    Meter { label: "CPU"; percent: root.cpu-percent; detail: ""; }
                    Meter { label: @tr("Memory"); percent: root.mem-percent; detail: root.mem-detail; }
                    Meter { label: @tr("Swap"); percent: root.swap-percent; detail: root.swap-detail; }
                }

                // top network (server when connected, local on welcome)
                NetSection {
                    heading: root.conn-state == 1 ? @tr("Server network") : @tr("Network");
                    up-text: root.net-top-up;
                    down-text: root.net-top-down;
                    history: root.net-top-history;
                    bar-color: root.conn-state == 1 ? Theme.ok : Theme.accent;
                    bar-opacity: root.conn-state == 1 ? 0.5 : 0.45;
                    show-selector: root.net-show-selector;
                    ifaces: root.net-ifaces;
                    selected: root.net-selected;
                    iface-selected(i) => { root.select-net-iface(i); }
                }

                // local network
                NetSection {
                    heading: @tr("Local network");
                    up-text: root.net-bot-up;
                    down-text: root.net-bot-down;
                    history: root.net-bot-history;
                    bar-color: Theme.accent;
                    bar-opacity: 0.45;
                }

                // mounts
                VerticalLayout {
                    spacing: 9px;
                    HorizontalLayout {
                        SideHeading { text: @tr("Mounts"); horizontal-stretch: 1; }
                        Text {
                            text: @tr("Free/Total");
                            font-family: Theme.font-mono;
                            font-size: 10px;
                            color: Theme.text-faint;
                            vertical-alignment: center;
                        }
                    }
                    for d in root.disks : MountRow {
                        path: d.path;
                        detail: d.detail;
                        percent: d.percent;
                    }
                }
            }
        }

        // --- footer ---
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            height: 53px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 16px;
                Text {
                    text: "v" + root.app-version;
                    font-family: Theme.font-mono;
                    font-size: 11px;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: seg.preferred-width;
                    background: Theme.seg-track;
                    border-radius: 8px;
                    seg := HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        SegThemeButton { icon: "\u{E430}"; value: 1; }  // wb_sunny
                        SegThemeButton { icon: "\u{E3A8}"; value: 2; }  // brightness_3
                        SegThemeButton { icon: "\u{E30C}"; value: 0; }  // desktop_windows
                    }
                }
            }
        }
    }
}
