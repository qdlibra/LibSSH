import { Theme } from "theme.slint";
import { LabeledInput, PrimaryButton, GhostButton } from "widgets.slint";
import { GroupInfo } from "group_dialog.slint";

export struct SessionDraft {
    id: string,
    name: string,
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    group: string,
    password: string,
    private-key-path: string,
    remember: bool,    // 勾选则把密码机器绑定加密存本地
    jump-session-id: string,   // "" = 不经跳板；否则为跳板会话的 id
    tunnels-text: string,      // 每行一条本地转发 [bind:]port:host:port
}

// Modal dialog for creating / editing an SSH session.
// The dialog is purely presentational — it stores values in mutable
// properties and emits `submit` / `cancel` callbacks up to the main window.
export component SessionDialog inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <bool> is-editing: false;
    in-out property <string> draft-id;
    in-out property <string> draft-name;
    in-out property <string> draft-host;
    in-out property <string> draft-port: "22";
    in-out property <string> draft-user: "root";
    in-out property <string> draft-auth: "password";
    in-out property <string> draft-group;
    in property <[GroupInfo]> groups;
    in-out property <string> draft-password;
    in-out property <bool> draft-remember: true;
    in-out property <string> draft-key-path;
    in-out property <string> draft-jump-session-id;
    in-out property <string> draft-tunnels-text;
    in property <[GroupInfo]> jump-candidates;   // name=会话 id，label=会话名（除当前会话外）
    // Connectivity test state, driven from Rust: "idle" | "testing" | "ok" | "fail"
    in-out property <string> test-status: "idle";
    in-out property <string> test-message;

    callback submit(SessionDraft);
    callback cancel();
    callback pick-key-file();   // open a native file picker for the private key
    callback test-connection(SessionDraft);  // probe the server with the current draft

    // 每次打开对话框时默认勾选「记住密码」；用户可手动取消。
    changed is-open => { if (self.is-open) { root.draft-remember = true; } }

    visible: is-open;
    background: #000000aa;

    // Swallow clicks on the backdrop
    TouchArea {
        width: 100%; height: 100%;
        clicked => { root.cancel(); }
    }

    Rectangle {
        width: 420px;
        height: 740px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.bg-panel;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;

        // Prevent backdrop click from propagating when user clicks inside the card
        TouchArea {
            width: 100%; height: 100%;
        }

        VerticalLayout {
            padding: 20px;
            spacing: 14px;

            Text {
                text: is-editing ? @tr("Edit session") : @tr("New session");
                color: Theme.text-primary;
                font-size: Theme.fs-xl;
                font-weight: 600;
            }

            LabeledInput {
                label: @tr("Name");
                placeholder: @tr("e.g. production web-01");
                value <=> root.draft-name;
            }

            HorizontalLayout {
                spacing: 10px;
                LabeledInput {
                    label: @tr("Host / IP");
                    placeholder: "192.168.1.10";
                    value <=> root.draft-host;
                    horizontal-stretch: 2;
                }
                LabeledInput {
                    label: @tr("Port");
                    placeholder: "22";
                    value <=> root.draft-port;
                    horizontal-stretch: 1;
                }
            }

            LabeledInput {
                label: @tr("Username");
                placeholder: "root";
                value <=> root.draft-user;
            }

            // Group — dropdown over the managed groups.
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Group");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: dd-ta.has-hover ? Theme.border-strong : Theme.border-subtle;
                    background: Theme.bg-root;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: root.draft-group == "" ? @tr("Default group") : root.draft-group;
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: clip;
                        }
                        Text {
                            text: "\u{E5CF}";   // expand_more
                            font-family: "Material Icons";
                            color: Theme.text-muted;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    dd-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { grp-pop.show(); }
                    }
                    grp-pop := PopupWindow {
                        x: 0;
                        y: parent.height + 2px;
                        width: parent.width;
                        height: min(root.groups.length, 8) * 29px + 8px;
                        Rectangle {
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 14px;
                            drop-shadow-color: Theme.shadow-color;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                for g in root.groups : Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: gi-ta.has-hover ? Theme.bg-hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 4px;
                                            background: g.has-color ? g.color : Theme.text-faint;
                                        }
                                        Text {
                                            text: g.label;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: clip;
                                        }
                                        if g.name == root.draft-group : Text {
                                            text: "\u{E5CA}";   // check
                                            font-family: "Material Icons";
                                            color: Theme.accent;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    gi-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.draft-group = g.name;
                                            grp-pop.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Auth method toggle
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Authentication");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 30px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        background: root.draft-auth == "password" ? Theme.accent : Theme.bg-root;
                        border-color: root.draft-auth == "password" ? Theme.accent : Theme.border-subtle;
                        Text {
                            text: @tr("Password");
                            color: root.draft-auth == "password" ? white : Theme.text-primary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.draft-auth = "password"; }
                        }
                    }
                    Rectangle {
                        height: 30px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        background: root.draft-auth == "key" ? Theme.accent : Theme.bg-root;
                        border-color: root.draft-auth == "key" ? Theme.accent : Theme.border-subtle;
                        Text {
                            text: @tr("Private key");
                            color: root.draft-auth == "key" ? white : Theme.text-primary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.draft-auth = "key"; }
                        }
                    }
                }
            }

            if root.draft-auth == "password" : LabeledInput {
                label: @tr("Password");
                placeholder: root.is-editing ? @tr("Leave blank to keep the current password") : "••••••••";
                password: true;
                value <=> root.draft-password;
            }

            if root.draft-auth == "password" : HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 18px; height: 18px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: root.draft-remember ? Theme.accent : Theme.border-subtle;
                    background: root.draft-remember ? Theme.accent : Theme.bg-root;
                    Text {
                        text: root.draft-remember ? "✓" : "";
                        color: white;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.draft-remember = !root.draft-remember; }
                    }
                }
                Text {
                    text: @tr("Remember password (encrypted on this machine)");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }
            }

            if root.draft-auth == "key" : VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Private key file");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 32px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: keyin.has-focus ? Theme.accent : Theme.border-subtle;
                        background: Theme.bg-root;
                        keyin := TextInput {
                            x: 10px; y: 0px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text <=> root.draft-key-path;
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            single-line: true;
                        }
                        if root.draft-key-path == "" : Text {
                            x: 10px; y: 0px;
                            height: parent.height;
                            text: "/home/you/.ssh/id_ed25519";
                            color: Theme.text-muted;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 64px; height: 32px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        background: browse-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                        Text {
                            text: @tr("Browse…");
                            color: Theme.text-primary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        browse-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick-key-file(); }
                        }
                    }
                }
                Text {
                    text: @tr("Pick the private key itself (not the .pub public key)");
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                }
            }

            // 跳板机（经已保存会话，可选）
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Jump host (via saved session)");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: jmp-ta.has-hover ? Theme.border-strong : Theme.border-subtle;
                    background: Theme.bg-root;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        // 折叠态：空=直连；否则显示所选候选的「会话名」。用 clip 而非 elide，
                        // 避免纯中文会话名被整词丢弃（见 elide 吃 CJK 的已知问题）。
                        if root.draft-jump-session-id == "" : Text {
                            text: @tr("Direct (no jump)");
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: clip;
                        }
                        for c in root.jump-candidates : Text {
                            text: c.name == root.draft-jump-session-id ? c.label : "";
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: c.name == root.draft-jump-session-id ? 1 : 0;
                            overflow: clip;
                        }
                        Text {
                            text: "\u{E5CF}";   // expand_more
                            font-family: "Material Icons";
                            color: Theme.text-muted;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    jmp-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { jmp-pop.show(); }
                    }
                    jmp-pop := PopupWindow {
                        x: 0;
                        y: parent.height + 2px;
                        width: parent.width;
                        height: min(root.jump-candidates.length + 1, 8) * 29px + 8px;
                        Rectangle {
                            background: Theme.bg-panel;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            drop-shadow-blur: 14px;
                            drop-shadow-color: Theme.shadow-color;
                            VerticalLayout {
                                padding: 4px;
                                spacing: 1px;
                                Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: jn-ta.has-hover ? Theme.bg-hover : transparent;
                                    Text {
                                        x: 8px;
                                        text: @tr("Direct (no jump)");
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-md;
                                        vertical-alignment: center;
                                    }
                                    jn-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.draft-jump-session-id = ""; jmp-pop.close(); }
                                    }
                                }
                                for c in root.jump-candidates : Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: jc-ta.has-hover ? Theme.bg-hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: c.label;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-md;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: clip;
                                        }
                                        if c.name == root.draft-jump-session-id : Text {
                                            text: "\u{E5CA}";   // check
                                            font-family: "Material Icons";
                                            color: Theme.accent;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    jc-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.draft-jump-session-id = c.name; jmp-pop.close(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 本地端口转发（每行一条 [bind:]port:host:port）
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: @tr("Local forwards (one per line: [bind:]port:host:port)");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }
                Rectangle {
                    height: 56px;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: tin.has-focus ? Theme.accent : Theme.border-subtle;
                    background: Theme.bg-root;
                    tin := TextInput {
                        x: 10px;
                        y: 6px;
                        width: parent.width - 20px;
                        height: parent.height - 12px;
                        text <=> root.draft-tunnels-text;
                        color: Theme.text-primary;
                        font-size: Theme.fs-md;
                        single-line: false;
                        wrap: no-wrap;
                    }
                }
            }

            // Connectivity test result — 始终预留的固定展示区，取代原先的占位 spacer。
            // 固定占据输入区与按钮之间的剩余空间：测试结果出现/消失或长短变化都不改变
            // 布局总高，按钮不会被挤出窗口。idle 时显示灰色占位「<未测试>」。
            Rectangle {
                vertical-stretch: 1;
                min-height: 34px;
                clip: true;
                VerticalLayout {
                    Text {
                        text: root.test-status == "ok" ? "✓ " + root.test-message
                            : root.test-status == "fail" ? "✗ " + root.test-message
                            : root.test-status == "testing" ? root.test-message
                            : @tr("Not tested");
                        color: root.test-status == "ok" ? Theme.success
                            : root.test-status == "fail" ? Theme.danger
                            : root.test-status == "testing" ? Theme.text-secondary
                            : Theme.text-muted;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                        overflow: clip;
                        vertical-alignment: top;
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                GhostButton {
                    text: root.test-status == "testing" ? @tr("Testing…") : @tr("Test connection");
                    clicked => {
                        if (root.test-status != "testing") {
                            root.test-connection({
                                id: root.draft-id,
                                name: root.draft-name,
                                host: root.draft-host,
                                port: root.draft-port.to-float(),
                                user: root.draft-user,
                                auth: root.draft-auth,
                                group: root.draft-group,
                                password: root.draft-password,
                                private-key-path: root.draft-key-path,
                                remember: root.draft-remember,
                                jump-session-id: root.draft-jump-session-id,
                                tunnels-text: root.draft-tunnels-text,
                            });
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                GhostButton {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                PrimaryButton {
                    text: is-editing ? @tr("Save") : @tr("Create");
                    clicked => {
                        root.submit({
                            id: root.draft-id,
                            name: root.draft-name,
                            host: root.draft-host,
                            port: root.draft-port.to-float(),
                            user: root.draft-user,
                            auth: root.draft-auth,
                            group: root.draft-group,
                            password: root.draft-password,
                            private-key-path: root.draft-key-path,
                            remember: root.draft-remember,
                            jump-session-id: root.draft-jump-session-id,
                            tunnels-text: root.draft-tunnels-text,
                        });
                    }
                }
            }
        }
    }
}
