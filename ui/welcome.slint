import { Theme } from "theme.slint";
import { GhostButton } from "widgets.slint";

export struct SessionInfo {
    id: string,
    name: string,
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    last-used: string, // ISO timestamp or "never"
    latency: int,      // round-trip ms; -1 = probing, -2 = unreachable/timeout
    group-label: string, // group header label ("" = no header / ungrouped-only)
    group-index: int,    // group order index (used for grouping boundaries)
    group-size: int,     // number of (filtered) sessions in this group
    group-color: brush,  // the group's colour (ignored when group-has-color is false)
    group-has-color: bool,
}

// --- ConnectButton (accent text button) ------------------------------------
component ConnectButton inherits Rectangle {
    callback clicked();
    height: 30px;
    border-radius: 7px;
    background: ta.pressed ? Theme.accent-pressed
        : (ta.has-hover ? Theme.accent-hover : Theme.accent);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: @tr("Connect");
            color: white;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// --- RowIconButton (30×30 bordered icon) -----------------------------------
component RowIconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 7px;
    border-width: 1px;
    border-color: ta.has-hover && danger ? Theme.danger-soft : Theme.border;
    background: ta.has-hover ? (danger ? Theme.danger-soft : Theme.row-hover) : transparent;
    animate background, border-color { duration: 120ms; }
    Text {
        text: glyph;
        font-family: "Material Icons";
        font-size: 15px;
        color: ta.has-hover ? (danger ? Theme.danger : Theme.text) : Theme.text-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// --- GroupHeader (dot + label + count pill + divider) -----------------------
component GroupHeader inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <brush> accent;
    in property <bool> has-color;
    property <brush> gcolor: has-color ? accent : Theme.text-faint;
    height: 34px;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 13px;
        padding-bottom: 8px;
        spacing: 9px;
        Rectangle {
            width: 7px; height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: gcolor;
        }
        Text {
            text: label;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: Theme.text-dim;
            vertical-alignment: center;
        }
        Rectangle {
            border-radius: 9px;
            background: Theme.track;
            HorizontalLayout {
                padding-left: 7px; padding-right: 7px;
                padding-top: 1px; padding-bottom: 1px;
                Text {
                    text: "\{count}";
                    font-family: Theme.font-mono;
                    font-size: 10px;
                    color: Theme.text-faint;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - 1px) / 2;
                width: parent.width; height: 1px;
                background: Theme.border;
            }
        }
    }
}

// --- SessionRow ------------------------------------------------------------
component SessionRow inherits Rectangle {
    in property <SessionInfo> session;
    callback connect();
    callback edit();
    callback request-delete();

    property <brush> gcolor: session.group-has-color ? session.group-color : Theme.text-faint;
    property <string> lat-text: session.latency == -1 ? "···"
        : session.latency == -2 ? @tr("timeout")
        : "\{session.latency}ms";
    property <brush> lat-color: session.latency == -1 ? Theme.text-faint
        : session.latency == -2 ? Theme.danger
        : session.latency < 100 ? Theme.ok
        : session.latency < 250 ? Theme.warn : Theme.danger;

    height: 48px;
    background: row-ta.has-hover ? Theme.row-hover : transparent;
    animate background { duration: 100ms; }

    // Declared FIRST so the action buttons stay clickable above it.
    row-ta := TouchArea { }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;

        // name cell (flex)
        HorizontalLayout {
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 120px;
            spacing: 11px;
            Rectangle {
                width: 3px; height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: 2px;
                background: gcolor;
            }
            Rectangle {
                width: 28px; height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: gcolor.with-alpha(0.14);
                Text {
                    text: "\u{E875}";   // Material "dns" server glyph
                    font-family: "Material Icons";
                    color: gcolor;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: session.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: 500;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }

        Text {
            text: session.host;
            font-family: Theme.font-mono;
            color: Theme.text-dim;
            font-size: 12px;
            width: 150px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: "\{session.port}";
            font-family: Theme.font-mono;
            color: Theme.text-faint;
            font-size: 12px;
            width: 52px;
            vertical-alignment: center;
        }
        // latency — colour-graded text, no background
        Text {
            text: lat-text;
            font-family: Theme.font-mono;
            font-size: 11px;
            font-weight: 500;
            color: lat-color;
            width: 74px;
            vertical-alignment: center;
        }
        Text {
            text: session.user;
            font-family: Theme.font-mono;
            color: Theme.text-dim;
            font-size: 12px;
            width: 96px;
            vertical-alignment: center;
            overflow: elide;
        }
        // actions
        HorizontalLayout {
            width: 160px;
            alignment: end;
            spacing: 7px;
            ConnectButton {
                y: (parent.height - self.height) / 2;
                clicked => { root.connect(); }
            }
            RowIconButton {
                glyph: "\u{E3C9}";   // edit
                y: (parent.height - self.height) / 2;
                clicked => { root.edit(); }
            }
            RowIconButton {
                glyph: "\u{E872}";   // delete
                danger: true;
                y: (parent.height - self.height) / 2;
                clicked => { root.request-delete(); }
            }
        }
    }
}

// --- Column header (aligned 1:1 with SessionRow) ---------------------------
component ListHeader inherits Rectangle {
    height: 36px;
    background: Theme.col-head;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;
        Text {
            text: @tr("Name");
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 120px;
            font-size: 11px; font-weight: 600; letter-spacing: 0.3px;
            color: Theme.text-faint; vertical-alignment: center;
        }
        Text {
            text: @tr("Address"); width: 150px;
            font-size: 11px; font-weight: 600; letter-spacing: 0.3px;
            color: Theme.text-faint; vertical-alignment: center;
        }
        Text {
            text: @tr("Port"); width: 52px;
            font-size: 11px; font-weight: 600; letter-spacing: 0.3px;
            color: Theme.text-faint; vertical-alignment: center;
        }
        Text {
            text: @tr("Latency"); width: 74px;
            font-size: 11px; font-weight: 600; letter-spacing: 0.3px;
            color: Theme.text-faint; vertical-alignment: center;
        }
        Text {
            text: @tr("User"); width: 96px;
            font-size: 11px; font-weight: 600; letter-spacing: 0.3px;
            color: Theme.text-faint; vertical-alignment: center;
        }
        Text {
            text: @tr("Actions"); width: 160px;
            font-size: 11px; font-weight: 600; letter-spacing: 0.3px;
            color: Theme.text-faint;
            horizontal-alignment: right; vertical-alignment: center;
        }
    }
}

// --- Welcome ---------------------------------------------------------------
export component Welcome inherits Rectangle {
    in property <[SessionInfo]> sessions;
    in property <string> session-subtitle;
    in-out property <string> search-text;
    in property <string> import-hint;        // result text after an import (unused in this layout)
    callback new-session();
    callback search-changed(string);
    callback manage-groups();
    callback import-ssh-config();
    callback connect-session(string);
    callback edit-session(string);
    callback remove-session(string);
    in-out property <bool> delete-confirm-open: false;
    in-out property <string> pending-delete-id;
    in-out property <string> pending-delete-name;

    background: Theme.bg-main;

    VerticalLayout {
        padding-left: 30px;
        padding-right: 30px;
        padding-top: 26px;
        padding-bottom: 30px;
        spacing: 20px;

        // --- Header ---------------------------------------------------------
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: @tr("Quick connect");
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                }
                Text {
                    text: root.session-subtitle;
                    color: Theme.text-dim;
                    font-size: 12.5px;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                // search box
                Rectangle {
                    width: 210px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: search-in.has-focus ? Theme.accent : Theme.border;
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        spacing: 8px;
                        Text {
                            text: "\u{E8B6}";   // Material "search"
                            font-family: "Material Icons";
                            color: Theme.text-faint;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            background: transparent;
                            horizontal-stretch: 1;
                            search-in := TextInput {
                                width: parent.width;
                                height: parent.height;
                                text <=> root.search-text;
                                color: Theme.text;
                                font-size: 12.5px;
                                vertical-alignment: center;
                                single-line: true;
                                edited => { root.search-changed(self.text); }
                            }
                            if root.search-text == "" : Text {
                                text: @tr("Search sessions…");
                                color: Theme.text-faint;
                                font-size: 12.5px;
                                vertical-alignment: center;
                                height: parent.height;
                            }
                        }
                    }
                }
                // new session
                Rectangle {
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: new-ta.pressed ? Theme.accent-pressed
                        : (new-ta.has-hover ? Theme.accent-hover : Theme.accent);
                    animate background { duration: 120ms; }
                    HorizontalLayout {
                        padding-left: 15px; padding-right: 15px; spacing: 7px;
                        Text {
                            text: "\u{E145}";   // Material "add"
                            font-family: "Material Icons";
                            color: white;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("New connection");
                            color: white;
                            font-size: 12.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    new-ta := TouchArea { mouse-cursor: pointer; clicked => { root.new-session(); } }
                }
                // manage groups — right of New connection
                Rectangle {
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: mg-ta.has-hover ? Theme.border-strong : Theme.border;
                    background: mg-ta.has-hover ? Theme.row-hover : transparent;
                    HorizontalLayout {
                        padding-left: 13px;
                        padding-right: 13px;
                        spacing: 7px;
                        Text {
                            text: "\u{E574}";   // Material "category" (groups)
                            font-family: "Material Icons";
                            color: Theme.text-dim;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: @tr("Manage groups");
                            color: Theme.text;
                            font-size: 12.5px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                    mg-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.manage-groups(); }
                    }
                }
            }
        }

        // --- Empty state ----------------------------------------------------
        if sessions.length == 0 : Rectangle {
            vertical-stretch: 1;
            background: Theme.card;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: @tr("No sessions yet");
                    color: Theme.text-dim;
                    font-size: Theme.fs-md;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("Use 'New session' (top-right) to add your first server");
                    color: Theme.text-faint;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                }
            }
        }

        // --- List card ------------------------------------------------------
        if sessions.length > 0 : Flickable {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: max(self.height, card-col.preferred-height);
            card-col := VerticalLayout {
                alignment: start;
                Rectangle {
                    background: Theme.card;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    VerticalLayout {
                        ListHeader {}
                        Rectangle { height: 1px; background: Theme.border; }
                        for session[i] in root.sessions : VerticalLayout {
                            if session.group-label != "" && (i == 0 || root.sessions[i - 1].group-index != session.group-index) : GroupHeader {
                                label: session.group-label;
                                count: session.group-size;
                                accent: session.group-color;
                                has-color: session.group-has-color;
                            }
                            SessionRow {
                                session: session;
                                connect => { root.connect-session(session.id); }
                                edit => { root.edit-session(session.id); }
                                request-delete => {
                                    root.pending-delete-id = session.id;
                                    root.pending-delete-name = session.name;
                                    root.delete-confirm-open = true;
                                }
                            }
                        }
                        Rectangle { height: 8px; }
                    }
                }
            }
        }
    }

    // --- Delete confirmation modal -----------------------------------------
    Rectangle {
        visible: root.delete-confirm-open;
        width: parent.width;
        height: parent.height;
        background: #00000080;

        TouchArea { clicked => { root.delete-confirm-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(380px, parent.width - 48px);
            height: 180px;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.shadow-color;

            TouchArea {}   // swallow clicks inside the card

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: @tr("Delete session");
                    color: Theme.text;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                }
                Text {
                    text: @tr("Delete this session from quick connect?");
                    color: Theme.text-dim;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                Text {
                    text: root.pending-delete-name;
                    color: Theme.text;
                    font-size: Theme.fs-md;
                    font-weight: 600;
                    overflow: elide;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton {
                        text: @tr("Cancel");
                        clicked => {
                            root.delete-confirm-open = false;
                            root.pending-delete-id = "";
                            root.pending-delete-name = "";
                        }
                    }
                    Rectangle {
                        width: 84px; height: 30px;
                        border-radius: Theme.radius-sm;
                        background: ok-ta.pressed ? Theme.danger.with-alpha(0.75)
                            : (ok-ta.has-hover ? Theme.danger.with-alpha(0.88) : Theme.danger);
                        Text {
                            text: @tr("OK");
                            color: white;
                            font-size: Theme.fs-sm;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ok-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.remove-session(root.pending-delete-id);
                                root.delete-confirm-open = false;
                                root.pending-delete-id = "";
                                root.pending-delete-name = "";
                            }
                        }
                    }
                }
            }
        }
    }
}
