import { Theme } from "theme.slint";
import { PrimaryButton, GhostButton } from "widgets.slint";

export struct SessionInfo {
    id: string,
    name: string,
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    last-used: string, // ISO timestamp or "never"
}

component SessionActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> button-width: 66px;
    callback clicked();

    width: button-width;
    height: 24px;
    border-radius: Theme.radius-sm;
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.danger : Theme.border-subtle;
    background: primary
        ? (action-ta.pressed ? Theme.accent-pressed
           : (action-ta.has-hover ? Theme.accent-hover : Theme.accent))
        : danger
            ? (action-ta.has-hover ? Theme.danger.with-alpha(0.14) : transparent)
            : (action-ta.has-hover ? Theme.bg-hover : Theme.bg-panel);
    animate background, border-color { duration: 120ms; }

    Text {
        text: root.text;
        color: primary ? white : (danger ? Theme.danger : Theme.text-primary);
        font-size: Theme.fs-xs;
        font-weight: primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    action-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- SessionRow ------------------------------------------------------------
component SessionRow inherits Rectangle {
    in property <SessionInfo> session;
    callback connect();
    callback edit();
    callback request-delete();

    height: 40px;
    border-radius: Theme.radius-sm;
    background: transparent;

    // Row content ------------------------------------------------------------
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;

        Rectangle {
            width: 18px; height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.bg-elevated;
            Text {
                text: "\u{E875}";   // Material Icons "dns" — server/host glyph
                font-family: "Material Icons";
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: session.name;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            width: 130px;
            overflow: elide;
        }
        Text {
            text: session.host + ":" + session.port;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            width: 150px;
            overflow: elide;
        }
        Text {
            text: session.user;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        SessionActionButton {
            text: @tr("Connect");
            primary: true;
            clicked => { root.connect(); }
        }
        SessionActionButton {
            text: @tr("Edit");
            clicked => { root.edit(); }
        }
        SessionActionButton {
            text: @tr("Delete");
            danger: true;
            clicked => { root.request-delete(); }
        }
    }
}

// --- Welcome ---------------------------------------------------------------
export component Welcome inherits Rectangle {
    in property <[SessionInfo]> sessions;
    in property <string> import-hint;        // result text after an import
    callback new-session();
    callback import-ssh-config();
    callback connect-session(string);
    callback edit-session(string);
    callback remove-session(string);
    in-out property <bool> delete-confirm-open: false;
    in-out property <string> pending-delete-id;
    in-out property <string> pending-delete-name;

    background: Theme.bg-root;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;

        VerticalLayout {
            spacing: 4px;
            Text {
                text: "LibSSH";
                color: Theme.text-primary;
                font-size: 28px;
                font-weight: 700;
            }
        }

        // Quick Connect card
        Rectangle {
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("Quick connect");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // Result of the last "Import ~/.ssh/config" (triggered from
                    // the settings menu), e.g. "imported 3".
                    Text {
                        text: root.import-hint;
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                    PrimaryButton {
                        text: @tr("+ New session");
                        clicked => { root.new-session(); }
                    }
                }

                if sessions.length == 0 : Rectangle {
                    height: 120px;
                    background: Theme.bg-root;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: @tr("No sessions yet");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("Use 'New session' (top-right) to add your first server");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                        }
                    }
                }

                if sessions.length > 0 : VerticalLayout {
                    spacing: 2px;
                    for session[i] in sessions : SessionRow {
                        session: session;
                        connect => { root.connect-session(session.id); }
                        edit => { root.edit-session(session.id); }
                        request-delete => {
                            root.pending-delete-id = session.id;
                            root.pending-delete-name = session.name;
                            root.delete-confirm-open = true;
                        }
                    }
                }
            }
        }

        // Filler
        Rectangle { vertical-stretch: 1; }
    }

    Rectangle {
        visible: root.delete-confirm-open;
        width: parent.width;
        height: parent.height;
        background: #00000080;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(380px, parent.width - 48px);
            height: 178px;
            background: Theme.bg-panel;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000070;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: @tr("Delete session");
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                }

                Text {
                    text: @tr("Delete this session from quick connect?");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }

                Text {
                    text: root.pending-delete-name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-md;
                    font-weight: 600;
                    overflow: elide;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;

                    GhostButton {
                        text: @tr("Cancel");
                        clicked => {
                            root.delete-confirm-open = false;
                            root.pending-delete-id = "";
                            root.pending-delete-name = "";
                        }
                    }

                    SessionActionButton {
                        text: @tr("OK");
                        danger: true;
                        button-width: 80px;
                        clicked => {
                            root.remove-session(root.pending-delete-id);
                            root.delete-confirm-open = false;
                            root.pending-delete-id = "";
                            root.pending-delete-name = "";
                        }
                    }
                }
            }
        }
    }
}
