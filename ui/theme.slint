// Central design tokens for LibSSH.
// Palette follows the LibSSH design spec (IBM Plex mockups). The design token
// names below (bg-main, card, col-head, text, text-dim, …) are the source of
// truth; the legacy names further down (bg-root, bg-panel, text-primary, …) are
// kept as aliases so existing pages pick up the new palette without edits.

export global Theme {
    // 0 = follow system, 1 = light, 2 = dark.
    in-out property <int> mode: 0;
    // True OS appearance, detected in Rust (src/system.rs) and pushed in via
    // `window.global::<Theme>().set_system_is_dark(..)`. We can't rely on
    // `Palette.color-scheme` here: the light/dark buttons write to it, which
    // permanently stops it reflecting the system, and an un-forced value reads
    // back as `unknown` — which the old `!= light` test wrongly rendered as dark.
    in property <bool> system-is-dark: false;
    out property <bool> is-dark: mode == 2 ? true
                               : mode == 1 ? false
                               : system-is-dark;

    // --- Design tokens (light / dark) --------------------------------------
    out property <brush> bg-app:       is-dark ? #0d0f13 : #e8eaee;
    out property <brush> bg-sidebar:   is-dark ? #14171d : #f5f6f9;
    out property <brush> bg-main:      is-dark ? #1a1d24 : #fbfbfc;
    out property <brush> card:         is-dark ? #1f232b : #ffffff;
    out property <brush> col-head:     is-dark ? #191c22 : #f6f7fa;
    out property <brush> title-bar:    is-dark ? #1a1d24 : #eef0f3;

    out property <brush> border:        is-dark ? #2a2e37 : #e6e8ec;
    out property <brush> border-strong: is-dark ? #363b46 : #d6d9df;

    out property <brush> text:       is-dark ? #e7e9ed : #1b1f24;
    out property <brush> text-dim:   is-dark ? #99a1ad : #5a626d;
    out property <brush> text-faint: is-dark ? #646b76 : #9099a4;

    out property <brush> track:      is-dark ? #2a2f38 : #e9ebef;
    out property <brush> row-hover:  is-dark ? #23272f : #f3f4f7;
    out property <brush> seg-track:  is-dark ? #23272f : #e6e8ec;
    out property <brush> seg-active: is-dark ? #363c47 : #ffffff;

    out property <brush> ok:          is-dark ? #3fb950 : #16a34a;
    out property <brush> ok-soft:     is-dark ? #10261a : #e7f6ec;
    out property <brush> warn:        is-dark ? #d29922 : #c2740a;
    out property <brush> warn-soft:   is-dark ? #2a2113 : #fbeede;
    out property <brush> danger:      is-dark ? #f85149 : #dc2626;
    out property <brush> danger-soft: is-dark ? #2d1717 : #fbeaea;

    out property <brush> accent:       is-dark ? #4493f8 : #2563eb;
    out property <brush> accent-soft:  is-dark ? #15263d : #eaf1ff;
    out property <brush> accent-hover: is-dark ? #5aa0fa : #1d4ed8;
    out property <brush> accent-pressed: is-dark ? #3a7fd6 : #1a3fb0;

    // Warm folder/icon tint for the file browser (light/dark variant).
    out property <brush> folder: is-dark ? #e3b341 : #d99b22;

    out property <color> shadow-color: is-dark ? #00000099 : #0f141e2e;

    // Terminal is always dark (GitHub-Dark palette, matched to src/app.rs ANSI16).
    out property <brush> term-bg: #0d1117;
    out property <brush> term-fg: #c9d1d9;

    // --- Legacy aliases (kept so existing pages adopt the new palette) ------
    out property <brush> bg-root:      bg-main;
    out property <brush> bg-panel:     card;
    out property <brush> bg-panel-alt: seg-track;
    out property <brush> bg-elevated:  track;
    out property <brush> bg-hover:     row-hover;
    out property <brush> bg-active:    track;

    out property <brush> border-subtle: border;

    out property <brush> text-primary:   text;
    out property <brush> text-secondary: text-dim;
    out property <brush> text-muted:     text-faint;

    out property <brush> success: ok;
    out property <brush> warning: warn;

    out property <brush> folder-icon: folder;

    // --- Typography --------------------------------------------------------
    out property <length> fs-xs: 11px;
    out property <length> fs-sm: 12px;
    out property <length> fs-md: 13px;
    out property <length> fs-lg: 15px;
    out property <length> fs-xl: 18px;

    out property <string> font-mono: "Cascadia Mono";

    // --- Geometry ----------------------------------------------------------
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;

    out property <length> gap-xs: 4px;
    out property <length> gap-sm: 8px;
    out property <length> gap-md: 12px;
    out property <length> gap-lg: 16px;
}
