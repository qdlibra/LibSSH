// Central design tokens for LibSSH.
// Keep these aligned with docs/UI guidelines.

export global Theme {
    // 0 = follow system, 1 = light, 2 = dark.
    in-out property <int> mode: 0;
    // True OS appearance, detected in Rust (src/system.rs) and pushed in via
    // `window.global::<Theme>().set_system_is_dark(..)`. We can't rely on
    // `Palette.color-scheme` here: the light/dark buttons write to it, which
    // permanently stops it reflecting the system, and an un-forced value reads
    // back as `unknown` — which the old `!= light` test wrongly rendered as dark.
    in property <bool> system-is-dark: false;
    out property <bool> is-dark: mode == 2 ? true
                               : mode == 1 ? false
                               : system-is-dark;

    // --- Palette -----------------------------------------------------------
    out property <brush> bg-root: is-dark ? #1b1d23 : #f4f6f8;
    out property <brush> bg-panel: is-dark ? #23262d : #ffffff;
    out property <brush> bg-panel-alt: is-dark ? #2a2d35 : #edf1f5;
    out property <brush> bg-elevated: is-dark ? #30333c : #e6ebf1;
    out property <brush> bg-hover: is-dark ? #373a44 : #dde4ec;
    out property <brush> bg-active: is-dark ? #3f4350 : #cfd9e4;

    out property <brush> border-subtle: is-dark ? #3a3d46 : #d4dbe4;
    out property <brush> border-strong: is-dark ? #4a4e59 : #b9c4d0;

    out property <brush> text-primary: is-dark ? #e6e8ee : #1f2733;
    out property <brush> text-secondary: is-dark ? #a8adb8 : #526071;
    out property <brush> text-muted: is-dark ? #6b6f7a : #8591a0;

    out property <brush> accent: is-dark ? #4a90e2 : #256ec1;
    out property <brush> accent-hover: is-dark ? #5aa0f2 : #2f7ed6;
    out property <brush> accent-pressed: is-dark ? #3a80d2 : #1f5fab;

    out property <brush> success: is-dark ? #4ec9b0 : #168c74;
    out property <brush> warning: is-dark ? #e2a84a : #b26f00;
    out property <brush> danger: is-dark ? #e25c5c : #c23a3a;

    out property <brush> term-bg: #0e0f13;
    out property <brush> term-fg: #d4d4d4;

    // --- Typography --------------------------------------------------------
    out property <length> fs-xs: 11px;
    out property <length> fs-sm: 12px;
    out property <length> fs-md: 13px;
    out property <length> fs-lg: 15px;
    out property <length> fs-xl: 18px;

    out property <string> font-mono: "Cascadia Mono";

    // --- Geometry ----------------------------------------------------------
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;

    out property <length> gap-xs: 4px;
    out property <length> gap-sm: 8px;
    out property <length> gap-md: 12px;
    out property <length> gap-lg: 16px;
}
